# jevrag environment. Copy to .env and fill in only what you use:
#   cp .env.example .env && chmod 600 .env
# The jevrag CLI reads ./.env automatically (--env-file to choose another file,
# --no-env-file to skip). Variables already set in your shell take precedence.
# Empty values are ignored. Never commit .env.

# --- Jev (set ONE; with jev.backend: auto the first one found is used, in this order) ---
# TypeSafe direct: https://console.typesafe.ai/
TYPESAFE_API_KEY=
# Vercel AI Gateway (also works for gateway: embeddings and answers)
AI_GATEWAY_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=

# --- Embeddings ---
# openai:<model>, and the openai answer provider
OPENAI_API_KEY=
# ollama:<model> (default http://localhost:11434)
OLLAMA_HOST=

# --- Answer LLM (only for `jevrag query --answer` / Pipeline.answer) ---
# anthropic answer provider
ANTHROPIC_API_KEY=

# --- Vector databases (only the one you use) ---
# pgvector: read via store.dsn_env (default DATABASE_URL),
# e.g. postgresql://user:password@localhost:5432/dbname
DATABASE_URL=
# Qdrant Cloud (not needed for a local server or embedded mode)
QDRANT_API_KEY=
# Pinecone (experimental adapter): key, plus cloud/region for index creation (defaults aws / us-east-1)
PINECONE_API_KEY=
PINECONE_CLOUD=
PINECONE_REGION=

# --- Debugging ---
# 1 = full tracebacks from the CLI
JEVRAG_DEBUG=
